{
  "actorSpecification": 1,
  "name": "upwork-scraper",
  "title": "Upwork Best Matches Scraper",
  "description": "Scrapes best match jobs from Upwork using login credentials",
  "version": "0.1",
  "dockerfile": "./Dockerfile",
  "input": "./INPUT_SCHEMA.json",
  "defaultRunOptions": {
    "memoryMbytes": 1024,
    "timeoutSecs": 300,
    "build": "latest"
  },
  "environmentVariables": {
    "APIFY_HEADLESS": "1",
    "APIFY_XVFB": "1"
  }
}
